  title                          String
  slug                           String
  short_description              String
  description                    String
  icon                           String
  image                          String?
  price_start                    Decimal
  duration                       String
  difficulty                     String
  is_popular                     Boolean
  is_featured                    Boolean
  is_active                      Boolean
  order                          Int
  created_at                     DateTime
  updated_at                     DateTime
  category_id                    Int
  breadcrumb_label               String
  bts_poster                     String?
  bts_title                      String
  bts_video_url                  String
  cta_primary_label              String
  cta_primary_url                String
  cta_secondary_label            String
  cta_secondary_url              String
  cta_text                       String
  cta_title                      String
  features_intro                 String
  features_section_title         String
  meta_description               String
  meta_title                     String
  other_services_title           String
  why_us_bullets                 String
  why_us_intro                   String
  why_us_title                   String
  faq_section_title              String
  card_image                     String?
  canonical_url                  String
  meta_robots                    String

  @@map("service_service")
}

model ServiceServiceTechnologies {
  id                             Int @id @default(autoincrement())
  service_id                     Int
  techstack_id                   Int

  @@map("service_service_technologies")
}

model ServiceServicebundle {
  id                             Int @id @default(autoincrement())
  title                          String
  slug                           String
  description                    String
  original_price                 Decimal
  discounted_price               Decimal
  icon                           String
  badge                          String
  is_popular                     Boolean
  is_active                      Boolean
  order                          Int
  created_at                     DateTime
  updated_at                     DateTime
  discount_percentage            Int

  @@map("service_servicebundle")
}

model ServiceServicebundleServices {
  id                             Int @id @default(autoincrement())
  servicebundle_id               Int
  service_id                     Int

  @@map("service_servicebundle_services")
}

model ServiceServicecategory {
  id                             Int @id @default(autoincrement())
  name                           String
  slug                           String
  icon                           String
  description                    String
  order                          Int
  is_active                      Boolean

  @@map("service_servicecategory")
}

model ServiceServicefaq {
  id                             Int @id @default(autoincrement())
  question                       String
  answer                         String
  order                          Int
  service_id                     Int

  @@map("service_servicefaq")
}

model ServiceServicefeature {
  id                             Int @id @default(autoincrement())
